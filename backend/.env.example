# AWS
AWS_REGION=us-east-1

# Bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5

# Cognito (used by auth_context to verify issuer / resolve users)
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=

# DynamoDB table names (set by CDK outputs; defaults match data-stack.ts tableName values)
USERS_TABLE_NAME=Users
SCHOOL_CLASSES_TABLE_NAME=SchoolClasses
SUBJECTS_TABLE_NAME=Subjects
CURRICULUMS_TABLE_NAME=Curriculums
STUDENT_PROGRESSES_TABLE_NAME=StudentProgresses
DAILY_CONDITIONS_TABLE_NAME=DailyConditions
STUDY_PLANS_TABLE_NAME=StudyPlans
STUDY_TASKS_TABLE_NAME=StudyTasks
STUDY_RECORDS_TABLE_NAME=StudyRecords
